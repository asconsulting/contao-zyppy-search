{
    "name":"asconsulting/contao-zyppy-search",
    "description":"Live page search with previews and teasers from Zyppy Page.",
    "homepage": "https://andrewstevens.consulting",
    "keywords":["contao", "search", "preview"],
    "type":"contao-bundle",
    "license":"AGPL-3.0-only",
    "authors":[
        {
            "name":"Andrew Stevens",
            "homepage":"https://andrewstevens.consulting"
        }
    ],
    "require":{
        "php": "^8.1",
        "contao/core-bundle": ">=5.3",
        "symfony/rate-limiter": ">=6.4",
        "asconsulting/contao-zyppy-page": "^5.0"
    },
    "require-dev": {
        "contao/manager-plugin": "^2.0",
        "phpunit/phpunit": "^9.6 || ^10.5 || ^11.0 || ^12.0",
        "contao/test-case": ">=5.3"
    },
    "conflict": {
        "contao/manager-plugin": "<2.0 || >=3.0"
    },
    "suggest": {
        "contao/news-bundle": "Enables the per-page News Reader override (tl_page.zyppy_news), which swaps the page teaser/image for the matching news article's.",
        "asconsulting/contao-zyppy-popup": "Adds the popupClear option that clears the results container each time a popup opens."
    },
    "autoload": {
        "psr-4": {
            "Zyppy\\Search\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Zyppy\\Search\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
	"extra": {
		"contao-manager-plugin": "Zyppy\\Search\\ContaoManager\\Plugin"
	}
}
